{
  "name": "habitquest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "db:init": "sqlite3 prisma/dev.db \".read prisma/migrations/20260606081500_init/migration.sql\"",
